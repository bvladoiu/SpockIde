CREATE TABLE contadeal_users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL,
    email TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

-- Queries
selectAll:
SELECT * FROM contadeal_users;

selectById:
SELECT * FROM contadeal_users WHERE id = ?;

selectByUsername:
SELECT * FROM contadeal_users WHERE username = ?;

selectByEmail:
SELECT * FROM contadeal_users WHERE email = ?;

insert:
INSERT INTO contadeal_users (username, email, created_at) VALUES (?, ?, ?);

update:
UPDATE contadeal_users SET username = ?, email = ? WHERE id = ?;

delete:
DELETE FROM contadeal_users WHERE id = ?;